<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <PackageId>Reeve.Cluster.AspNetCore</PackageId>
    <Description>The readiness check, fence middleware, acknowledgement filter, read index and skip endpoint of Reeve.Cluster for ASP.NET Core.</Description>
    <PackageTags>cluster;replicas;aspnetcore;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Reeve.Cluster/Reeve.Cluster.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reeve.Cluster.Tests" />
    <InternalsVisibleTo Include="Reeve.Cluster.IntegrationTests" />
    <InternalsVisibleTo Include="Reeve.Cluster.Harness" />
  </ItemGroup>

</Project>
